generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String   @default("TECHNICIAN")
  fullName  String?
  phone     String?
  sellerId  Int?
  whatsappRemindersEnabled Boolean @default(false)
  createdAt DateTime @default(now())

  clientContracts Contract[] @relation("ClientContracts")
  sellerContracts Contract[] @relation("SellerContracts")
  sales           Sale[]     @relation("SellerSales")
  clientSales     Sale[]     @relation("ClientSales")
}

model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  dni       String   @unique
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Sale {
  id                    Int       @id @default(autoincrement())
  correlativeId         String    @unique
  clientId              String?
  sellerUserId          Int?
  sellerUser            User?     @relation("SellerSales", fields: [sellerUserId], references: [id])
  clientUserId           Int?
  clientUser             User?     @relation("ClientSales", fields: [clientUserId], references: [id])
  dni                   String
  names                 String
  address               String
  phone                 String
  locationLink          String    @db.Text
  referencePhotos       String    @db.LongText
  installationDate      String?
  installationTimeRange String?
  internetPlan          String?
  details               String?   @db.Text
  status                String    @default("PENDING")
  sellerNameOrId        String
  installedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  contract Contract?
}

model Contract {
  id              Int       @id @default(autoincrement())
  contractNumber  String    @unique
  saleId          Int       @unique
  sale            Sale      @relation(fields: [saleId], references: [id])
  clientUserId    Int?
  clientUser      User?     @relation("ClientContracts", fields: [clientUserId], references: [id])
  sellerUserId    Int?
  sellerUser      User?     @relation("SellerContracts", fields: [sellerUserId], references: [id])
  startDate       DateTime
  endDate         DateTime
  monthlyAmount   Float     @default(0)
  reminderMode    String    @default("MANUAL")
  status          String    @default("PENDING_SIGNATURE")
  clientSignedAt  DateTime?
  sellerSignedAt  DateTime?
  clientSignature String?   @db.LongText
  sellerSignature String?   @db.LongText
  paymentDay      Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  receipts Receipt[]
}

model Receipt {
  id          Int      @id @default(autoincrement())
  contractId  Int
  contract    Contract @relation(fields: [contractId], references: [id])
  monthNumber Int
  dueDate     DateTime
  paidAt      DateTime?
  amount      Float
  status      String   @default("PENDING")
  lastReminderAt DateTime?
  createdAt   DateTime @default(now())
}

model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId Int?
  userName   String
  dni        String?
  photoUrl   String   @db.LongText
  latitude   Float
  longitude  Float
  createdAt  DateTime @default(now())
}
