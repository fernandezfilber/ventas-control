generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String   @default("SELLER")   // ADMIN | SELLER | CLIENT
  fullName  String?
  phone     String?
  sellerId  Int?     // Para clientes: ID del asesor asignado
  createdAt DateTime @default(now())

  clientContracts Contract[] @relation("ClientContracts")
  sellerContracts Contract[] @relation("SellerContracts")
}

model Sale {
  id                    Int       @id @default(autoincrement())
  correlativeId         String    @unique
  clientId              String?   // código interno de caja
  dni                   String
  names                 String
  address               String
  phone                 String
  locationLink          String    @db.Text
  installationDate      String?
  internetPlan          String?
  details               String?   @db.Text
  status                String    @default("PENDING")   // PENDING | INSTALLED
  sellerNameOrId        String
  installedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  contract Contract?
}

model Contract {
  id              Int       @id @default(autoincrement())
  contractNumber  String    @unique
  saleId          Int       @unique
  sale            Sale      @relation(fields: [saleId], references: [id])
  clientUserId    Int?
  clientUser      User?     @relation("ClientContracts", fields: [clientUserId], references: [id])
  sellerUserId    Int?
  sellerUser      User?     @relation("SellerContracts", fields: [sellerUserId], references: [id])
  startDate       DateTime
  endDate         DateTime
  monthlyAmount   Float     @default(0)
  status          String    @default("PENDING_SIGNATURE") // PENDING_SIGNATURE | ACTIVE | CANCELLED | EXPIRED
  clientSignedAt  DateTime?
  sellerSignedAt  DateTime?
  clientSignature String?   @db.LongText
  sellerSignature String?   @db.LongText
  paymentDay      Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  receipts Receipt[]
}

model Receipt {
  id                  Int       @id @default(autoincrement())
  contractId          Int
  contract            Contract  @relation(fields: [contractId], references: [id])
  monthNumber         Int       // 1, 2, 3
  dueDate             DateTime
  paidAt              DateTime?
  amount              Float
  status              String    @default("PENDING") // PENDING | PAID | OVERDUE
  reminderLastSentAt  DateTime?
  reminderCount       Int       @default(0)
  createdAt           DateTime  @default(now())
}
